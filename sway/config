# Sway config — merged from personal setup + Adil's EndeavourOS i3 port

### Font
font pango:JetBrainsMonoNL Nerd Font Medium 12

### Mod key
set $mod Mod4

### Variables
set $term wezterm
set $menu rofi -show drun -theme ~/.config/rofi/config.rasi

### Colors
set $darkbluetrans  #08052be6
set $darkblue       #08052b
set $lightblue      #5294e2
set $urgentred      #e53935
set $white          #ffffff
set $black          #000000
set $purple         #e345ff
set $darkgrey       #383c4a
set $grey           #b0b5bd
set $mediumgrey     #8b8b8b
set $yellowbrown    #e1b700

# Colors                    border       bg          text    indicator    child_border
client.focused              $lightblue   $darkblue   $white  $mediumgrey  $mediumgrey
client.unfocused            $darkblue    $darkblue   $grey   $darkgrey    $darkgrey
client.focused_inactive     $darkblue    $darkblue   $grey   $black       $black
client.urgent               $urgentred   $urgentred  $white  $yellowbrown $yellowbrown

### Window appearance
default_border pixel 2
default_floating_border pixel 2
workspace_layout default
gaps inner 8
gaps outer 4
floating_modifier $mod normal

### Output configuration
output DP-2 position 0 0
output DP-3 position 1920 0
output * bg "/home/samay/Desktop/Samay/Collective Behavior/Everything else/Sway configs/rockies.jpg" fill

### Input
input type:pointer {
    natural_scroll enabled
}

### Idle / lock
exec swayidle -w \
    timeout 480 'swaylock -f' \
    timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f'

### Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

### Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

### Layout and window management
bindsym $mod+Return exec $term
bindsym $mod+slash layout toggle split
bindsym $mod+comma layout toggle tabbed split
bindsym $mod+Ctrl+f fullscreen toggle
bindsym $mod+Ctrl+s layout stacking
bindsym $mod+Ctrl+g layout tabbed
bindsym $mod+Ctrl+v split vertical
bindsym $mod+Ctrl+Shift+v split horizontal
bindsym $mod+Ctrl+space floating toggle
bindsym $mod+Ctrl+a focus parent
bindsym $mod+space focus mode_toggle
bindsym $mod+Ctrl+d exec $menu
bindsym $mod+Ctrl+q kill
bindsym $mod+Ctrl+c reload
bindsym $mod+Shift+Escape exec swaylock -f

### App shortcuts
bindsym $mod+Ctrl+w exec /usr/bin/firefox
bindsym $mod+Ctrl+n exec /usr/bin/thunar

### Resize mode
mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Ctrl+r mode "resize"

